                        >

                            <option value="" selected disabled>
                                Choose your size
                            </option>

                            @forelse ($sneaker->sizes->sortBy('size') as $size)

                                <option
                                    value="{{ $size->id }}"
                                    @disabled($size->stock_quantity <= 0)
                                >
                                    EU {{ number_format((float) $size->size, 1) }}
                                    —
                                    @if ($size->stock_quantity > 0)
                                        {{ $size->stock_quantity }} available
                                    @else
                                        Sold Out
                                    @endif
                                </option>

                            @empty

                                <option value="" disabled>
