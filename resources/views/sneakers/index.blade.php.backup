            @php
                $totalStock = $sneaker->sizes->sum('stock_quantity');
            @endphp

            <div class="group overflow-hidden rounded-2xl border border-white/10 bg-[#111019] transition duration-300 hover:-translate-y-2 hover:border-purple-500/50">

                <!-- Sneaker image -->
                <div class="flex h-64 items-center justify-center overflow-hidden bg-[#191522] p-5">

                    @if ($sneaker->image)
                        <img
